# Real data must never leave the machine it was exported on.
# These are the files the script reads and writes in production.
ComputerList.txt
ComputerInformation.csv
*.log

# The sample files are intentional, so they are re-included after the rules
# above. They contain invented computers only.
!examples/ComputerList.sample.txt
!examples/ComputerInformation.sample.csv

# Build output and generated indexes: regenerable, never committed.
graphify-out/
graphify-rs-out/
.rag-index/
.callgraph-index.bin

# Session handoff files carry machine-local state, never published.
*-handoff.md
handoff-note.txt

# OS and editor noise
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store
*.swp
*~
.vscode/
.idea/

# PowerShell
*.ps1.bak
*.ps1.orig
